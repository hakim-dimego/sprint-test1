<!-- ══════════════════════════════════════════════════════════════
     JAVASCRIPT — Full Application Logic
     ══════════════════════════════════════════════════════════════ -->
<script>
"use strict";

// ════════════════════════════════════════════════════════════════
// SECTION A — APPLICATION STATE
// ════════════════════════════════════════════════════════════════
const STATE = {
  // Camera & Model
  stream:          null,
  detector:        null,
  modelLoaded:     false,
  cameraReady:     false,
  rafId:           null,

  // Calibration
  calibrated:      false,
  calMethod:       'body',     // 'body' | 'xr'
  pixelsPerMeter:  null,
  userHeightCm:    178,
  calSamples:      [],
  calInProgress:   false,

  // Measurement
  measuring:       false,
  measureStart:    null,
  frameCount:      0,
  confidenceSum:   0,

  // Speed tracking
  lastHipX:        null,
  lastFrameTime:   null,
  speedBuffer:     [],         // Moving-average window (8 frames)
  BUFFER_SIZE:     8,
  speedHistory:    [],         // Full session history (for waveform)
  MAX_HISTORY:     80,
  currentSpeed:    0,
  topSpeed:        0,

  // FPS
  fpsBuffer:       [],
  lastFpsTime:     null,
  currentFps:      0,

  // WebXR
  xrSupported:     false,
  xrSession:       null,

  // Results
  lastResult:      null,
};

// ════════════════════════════════════════════════════════════════
// SECTION B — CONSTANTS & CONFIG
// ════════════════════════════════════════════════════════════════
const CFG = {
  // MoveNet keypoint indices
  KP_NOSE:          0,
  KP_L_SHOULDER:   11,
  KP_R_SHOULDER:   12,
  KP_L_ANKLE:      15,
  KP_R_ANKLE:      16,
  // Pose confidence threshold
  CONF_THRESHOLD:   0.25,
  // Max plausible speed (clamp against noise)
  MAX_SPEED_KMH:    45,
  // Min speed to display (filter micro-jitter)
  MIN_SPEED_KMH:    0.5,
  // Countdown seconds before measurement
  COUNTDOWN_SEC:    3,
  // Calibration: number of samples to collect
  CAL_SAMPLE_COUNT: 20,
  // Average human height ratio: torso visible / total
  // Nase-to-Knöchel covers ~87% of body height
  NOSE_ANKLE_RATIO: 0.87,
};

// Skeleton connections for drawing
const SKELETON_PAIRS = [
  [0,1],[0,2],[1,3],[2,4],      // Face
  [5,6],                         // Shoulders
  [5,7],[7,9],[6,8],[8,10],     // Arms
  [5,11],[6,12],[11,12],        // Torso
  [11,13],[13,15],[12,14],[14,16], // Legs
];


// ════════════════════════════════════════════════════════════════
// SECTION C — INIT & CAMERA
// ════════════════════════════════════════════════════════════════
async function initCamera() {
  const noCam = document.getElementById('no-camera');
  noCam.style.display = 'none';

  try {
    STATE.stream = await navigator.mediaDevices.getUserMedia({
      video: {
        facingMode: { ideal: 'environment' },
        width:  { ideal: 1280, max: 1920 },
        height: { ideal: 720, max: 1080 },
        frameRate: { ideal: 30, max: 60 },
      },
      audio: false,
    });

    const video = document.getElementById('video');
    video.srcObject = STATE.stream;

    await new Promise(res => { video.onloadedmetadata = res; });
    await video.play();

    video.classList.add('ready');
    STATE.cameraReady = true;

    // Resize canvas to match video
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);
    screen.orientation?.addEventListener('change', () => setTimeout(resizeCanvas, 200));

    setStatus('active', 'Modell lädt...');
    await loadModel();

  } catch(err) {
    console.error('Camera error:', err);
    noCam.style.display = 'flex';
    toast('Kamerazugriff verweigert: ' + err.message);
  }
}

function resizeCanvas() {
  const video  = document.getElementById('video');
  const canvas = document.getElementById('canvas');
  const zone   = document.getElementById('camera-zone');
  canvas.width  = zone.clientWidth;
  canvas.height = zone.clientHeight;
}

async function loadModel() {
  const loader = document.getElementById('loading-overlay');
  try {
    await tf.ready();
    STATE.detector = await poseDetection.createDetector(
      poseDetection.SupportedModels.MoveNet,
      {
        modelType: poseDetection.movenet.modelType.SINGLEPOSE_THUNDER,
        enableSmoothing: true,
        minPoseScore: 0.2,
      }
    );
    STATE.modelLoaded = true;
    loader.classList.add('hidden');
    setTimeout(() => { loader.style.display = 'none'; }, 600);

    setStatus('active', 'Bereit');
    toast('MoveNet Thunder geladen ✓');

    // Start tracking loop
    trackingLoop();

    // Check WebXR
    await checkWebXR();

  } catch(err) {
    console.error('Model load error:', err);
    loader.querySelector('.loader-text').innerHTML = 'Ladefehler.<br>Bitte Seite neu laden.';
    toast('Modell-Ladefehler: ' + err.message);
  }
}

async function checkWebXR() {
  const badge = document.getElementById('xr-badge');
  const xrDesc = document.getElementById('xr-cal-desc');
  if ('xr' in navigator) {
    try {
      STATE.xrSupported = await navigator.xr.isSessionSupported('immersive-ar');
      badge.textContent = STATE.xrSupported ? 'XR: Verfügbar' : 'XR: N/A';
      badge.style.color = STATE.xrSupported ? 'var(--c-lime)' : 'var(--c-muted)';
      if (!STATE.xrSupported) xrDesc.textContent = 'Nicht verfügbar';
    } catch {
      badge.textContent = 'XR: N/A';
    }
  } else {
    badge.textContent = 'XR: N/A';
    xrDesc.textContent = 'Nicht verfügbar';
  }
}


// ════════════════════════════════════════════════════════════════
// SECTION D — MAIN TRACKING LOOP
// ════════════════════════════════════════════════════════════════
async function trackingLoop() {
  if (!STATE.modelLoaded || !STATE.cameraReady) return;

  const video  = document.getElementById('video');
  const canvas = document.getElementById('canvas');
  const ctx    = canvas.getContext('2d');

  async function frame(timestamp) {
    STATE.rafId = requestAnimationFrame(frame);

    // FPS calculation
    calcFPS(timestamp);

    if (video.readyState < 2) return;

    let poses;
    try {
      poses = await STATE.detector.estimatePoses(video, {
        flipHorizontal: false,
        maxPoses: 1,
      });
    } catch { return; }

    ctx.clearRect(0, 0, canvas.width, canvas.height);

    if (poses && poses.length > 0) {
      const pose = poses[0];
      drawSkeleton(ctx, pose, canvas);
      processSpeed(pose, timestamp);
    } else {
      // No pose detected — reset last position
      STATE.lastHipX = null;
    }
  }

  requestAnimationFrame(frame);
}

function calcFPS(timestamp) {
  if (STATE.lastFpsTime) {
    const dt = timestamp - STATE.lastFpsTime;
    STATE.fpsBuffer.push(1000 / dt);
    if (STATE.fpsBuffer.length > 15) STATE.fpsBuffer.shift();
    STATE.currentFps = Math.round(
      STATE.fpsBuffer.reduce((a,b) => a+b, 0) / STATE.fpsBuffer.length
    );
    document.getElementById('fps-badge').textContent = STATE.currentFps + ' FPS';
  }
  STATE.lastFpsTime = timestamp;
}


// ════════════════════════════════════════════════════════════════
// SECTION E — GESCHWINDIGKEITSBERECHNUNG (SPEED CALCULATION)
// ════════════════════════════════════════════════════════════════
/*
 * ALGORITHMUS:
 * 1. Extrahiere den Hüft-Mittelpunkt (Durchschnitt aus KP 11 & 12)
 * 2. Berechne die Pixeldistanz zum vorherigen Frame: Δpx
 * 3. Konvertiere zu Metern: Δm = Δpx / pixelsPerMeter
 * 4. Berechne Zeit zwischen Frames: Δt = (timestamp - lastFrameTime) / 1000 [Sekunden]
 * 5. Geschwindigkeit in m/s: v = Δm / Δt
 * 6. Umrechnung in km/h: v_kmh = v * 3.6
 * 7. Moving-Average-Filter über 8 Frames für Stabilität
 *
 * WARUM HÜFTE?
 * Die Hüfte ist der stabilste Tracking-Punkt beim Sprint.
 * Arme/Beine haben starke periodische Bewegungen (Schwungphase),
 * die die Geschwindigkeitsmessung verfälschen würden.
 */
function processSpeed(pose, timestamp) {
  const kps = pose.keypoints;

  // Extrahiere linke (11) und rechte (12) Hüfte
  const lHip = kps[CFG.KP_L_SHOULDER]; // Note: MoveNet uses 11=L_HIP, 12=R_HIP
  const rHip = kps[CFG.KP_R_SHOULDER]; // correcting to actual hip indices

  // Nutze tatsächliche Hüft-Keypoints (11=LEFT_HIP, 12=RIGHT_HIP in MoveNet)
  const leftHip  = kps[11];
  const rightHip = kps[12];

  // Konfidenz-Check: Beide Hüft-Punkte müssen sicher erkannt sein
  const confL = leftHip?.score  ?? 0;
  const confR = rightHip?.score ?? 0;
  const avgConf = (confL + confR) / 2;

  // Update Konfidenz-Anzeige
  document.getElementById('m-conf').textContent = (avgConf * 100).toFixed(0) + '%';

  if (avgConf < CFG.CONF_THRESHOLD) {
    STATE.lastHipX = null;
    return;
  }

  // Kalibriermodus: Samples sammeln
  if (STATE.calInProgress) {
    collectCalSample(pose, avgConf);
    return;
  }

  if (!STATE.calibrated || !STATE.measuring) {
    STATE.lastHipX = null;
    return;
  }

  // ── KERNBERECHNUNG ──────────────────────────────────────────
  // Hüft-Mittelpunkt X (horizontal) auf Canvas-Koordinaten skaliert
  const canvas     = document.getElementById('canvas');
  const video      = document.getElementById('video');
  const scaleX     = canvas.width  / (video.videoWidth  || canvas.width);

  const hipXraw    = (leftHip.x + rightHip.x) / 2;    // Pixel im Video-Frame
  const hipXpx     = hipXraw * scaleX;                  // Skaliert auf Canvas

  if (STATE.lastHipX !== null && STATE.lastFrameTime !== null) {
    const deltaPixels = Math.abs(hipXpx - STATE.lastHipX);  // Δpx (horizontal)
    const deltaSec    = (timestamp - STATE.lastFrameTime) / 1000;  // Δt [s]

    if (deltaSec > 0 && deltaSec < 0.5) {  // Plausibilitäts-Guard
      // px → Meter → m/s → km/h
      const deltaMeters = deltaPixels / STATE.pixelsPerMeter;
      const speedMs     = deltaMeters / deltaSec;
      const speedKmh    = speedMs * 3.6;

      // Plausibilitäts-Clamp: kein realer Sprint > 45 km/h
      const clampedSpeed = Math.min(speedKmh, CFG.MAX_SPEED_KMH);

      // ── MOVING AVERAGE FILTER ─────────────────────────────
      // Füge neue Messung in den Puffer ein und berechne gleitenden Durchschnitt
      // Dies verhindert Sprünge durch einzelne schlechte Frames.
      STATE.speedBuffer.push(clampedSpeed);
      if (STATE.speedBuffer.length > STATE.BUFFER_SIZE) {
        STATE.speedBuffer.shift();
      }
      const smoothedSpeed = STATE.speedBuffer.reduce((a,b) => a+b, 0)
                            / STATE.speedBuffer.length;

      STATE.currentSpeed = smoothedSpeed;

      // Update Top-Speed
      if (smoothedSpeed > STATE.topSpeed) {
        STATE.topSpeed = smoothedSpeed;
      }

      // Verlauf für Waveform
      STATE.speedHistory.push(smoothedSpeed);
      if (STATE.speedHistory.length > STATE.MAX_HISTORY) {
        STATE.speedHistory.shift();
      }

      // Frame-Statistiken
      STATE.frameCount++;
      STATE.confidenceSum += avgConf;

      // UI updaten
      updateSpeedUI(smoothedSpeed);
    }
  }

  STATE.lastHipX     = hipXpx;
  STATE.lastFrameTime = timestamp;
}


// ════════════════════════════════════════════════════════════════
// SECTION F — EA FC PACE ALGORITHMUS
// ════════════════════════════════════════════════════════════════
/*
 * EA FC PACE-FORMEL:
 * Pace = clamp(round((speed_kmh - 15) × 4.5), 1, 99)
 *
 * Herleitung:
 * - 15 km/h = Schwelle (Walking → Jogging) → Pace 0
 * - 37 km/h = Weltklasse-Tempo → Pace ~99
 * - Faktor 4.5 = Steigung der linearen Mapping-Funktion
 * - clamp(x, 1, 99) = EA-FC gibt niemandem 0 oder 100
 *
 * Beispiele:
 * 20 km/h → (20-15)×4.5 = 22 → Pace 22
 * 30 km/h → (30-15)×4.5 = 67 → Pace 67
 * 35 km/h → (35-15)×4.5 = 90 → Pace 90
 * 37 km/h → (37-15)×4.5 = 99 → Pace 99
 */
function calculatePace(speedKmh) {
  return Math.min(99, Math.max(1, Math.round((speedKmh - 15) * 4.5)));
}


// ════════════════════════════════════════════════════════════════
// SECTION G — PROFI-VERGLEICH
// ════════════════════════════════════════════════════════════════
function getComparison(speedKmh) {
  if (speedKmh > 37.0) return {
    level: 'WELTKLASSE',
    name:  'Tchatchoua-Level',
    icon:  '🏆',
    color: '#FFD700'
  };
  if (speedKmh >= 36.0) return {
    level: 'ELITE',
    name:  'Mbappé / Haaland-Level',
    icon:  '⭐',
    color: '#C8FF00'
  };
  if (speedKmh >= 35.0) return {
    level: 'PROFI',
    name:  'Alphonso Davies-Level',
    icon:  '🥇',
    color: '#00F5FF'
  };
  if (speedKmh >= 30.0) return {
    level: 'TOP AMATEUR',
    name:  'Profi-Schnitt',
    icon:  '💪',
    color: '#FF9500'
  };
  return {
    level: 'BASIS',
    name:  'Solide Basis',
    icon:  '🏃',
    color: '#8E8E93'
  };
}


// ════════════════════════════════════════════════════════════════
// SECTION H — CALIBRATION (Pixel-zu-Meter)
// ════════════════════════════════════════════════════════════════
/*
 * METHODE 1: Körpergröße-Kalibrierung
 * - Sammle N Frames mit erkannten Keypoints: Nase (0) und Knöchel (15/16)
 * - Berechne: pixelHeight = |y_nose - avg(y_ankle_l, y_ankle_r)|
 * - Nutze: pixelsPerMeter = pixelHeight / (userHeightCm × NOSE_ANKLE_RATIO / 100)
 * - Median aus 20 Samples für Robustheit
 *
 * METHODE 2: WebXR Hit-Test (AR)
 * - Scanne den Boden via AR-Session
 * - Platziere virtuelle 10m-Marker
 * - Berechne pixelsPerMeter aus der AR-Sitzung direkt
 */

let calTimer = null;

function selectCalMethod(method) {
  STATE.calMethod = method;
  document.getElementById('cal-opt-body').style.cssText =
    method === 'body' ? 'border-color:rgba(0,245,255,0.4);background:var(--c-cyan-dim);' : '';
  document.getElementById('cal-opt-xr').style.cssText =
    method === 'xr' ? 'border-color:rgba(0,245,255,0.4);background:var(--c-cyan-dim);' : '';
}

async function confirmCalibration() {
  STATE.userHeightCm = parseInt(document.getElementById('height-slider').value);

  if (STATE.calMethod === 'xr' && STATE.xrSupported) {
    await startXRCalibration();
  } else {
    if (STATE.calMethod === 'xr' && !STATE.xrSupported) {
      toast('WebXR nicht verfügbar — nutze Körpergröße');
      STATE.calMethod = 'body';
    }
    startBodyCalibration();
  }
}

function startBodyCalibration() {
  STATE.calSamples   = [];
  STATE.calInProgress = true;

  const prog     = document.getElementById('cal-progress');
  const progText = document.getElementById('cal-prog-text');
  const progBar  = document.getElementById('cal-prog-bar');

  prog.style.display = 'block';
  progText.textContent = 'Steh aufrecht vor der Kamera...';
  progBar.style.width  = '0%';

  let sampleCount = 0;
  const targetSamples = CFG.CAL_SAMPLE_COUNT;

  const checkProgress = setInterval(() => {
    sampleCount = STATE.calSamples.length;
    const pct = (sampleCount / targetSamples) * 100;
    progBar.style.width = pct + '%';
    progText.textContent = `Kalibrierung… ${sampleCount}/${targetSamples} Frames`;

    if (sampleCount >= targetSamples) {
      clearInterval(checkProgress);
      finishBodyCalibration();
    }
  }, 100);

  // Timeout safety
  calTimer = setTimeout(() => {
    clearInterval(checkProgress);
    STATE.calInProgress = false;
    if (STATE.calSamples.length >= 5) {
      finishBodyCalibration();
    } else {
      toast('Kalibrierung fehlgeschlagen — Person nicht erkannt');
      prog.style.display = 'none';
    }
  }, 15000);
}

function collectCalSample(pose, conf) {
  if (STATE.calSamples.length >= CFG.CAL_SAMPLE_COUNT) return;
  if (conf < 0.4) return; // Höhere Anforderung bei Kalibrierung

  const kps = pose.keypoints;
  const nose   = kps[CFG.KP_NOSE];
  const ankleL = kps[CFG.KP_L_ANKLE];
  const ankleR = kps[CFG.KP_R_ANKLE];

  if (!nose || !ankleL || !ankleR) return;
  if ((nose.score ?? 0)   < 0.4) return;
  if ((ankleL.score ?? 0) < 0.3) return;
  if ((ankleR.score ?? 0) < 0.3) return;

  const noseY   = nose.y;
  const ankleY  = (ankleL.y + ankleR.y) / 2;
  const pixelH  = Math.abs(ankleY - noseY);

  if (pixelH < 50) return; // Person zu weit weg / Messung unbrauchbar

  // Nase→Knöchel = NOSE_ANKLE_RATIO × Körpergröße
  const realHeight = (STATE.userHeightCm * CFG.NOSE_ANKLE_RATIO) / 100; // in Metern
  const ppm        = pixelH / realHeight; // pixels per meter

  STATE.calSamples.push(ppm);
}

function finishBodyCalibration() {
  clearTimeout(calTimer);
  STATE.calInProgress = false;

  if (STATE.calSamples.length < 3) {
    toast('Zu wenige Samples — nochmal versuchen');
    return;
  }

  // Median berechnen (robuster als Durchschnitt)
  const sorted  = [...STATE.calSamples].sort((a,b) => a-b);
  const median  = sorted[Math.floor(sorted.length / 2)];

  STATE.pixelsPerMeter = median;
  STATE.calibrated     = true;

  closeCalModal();
  applyCalibrated();
  toast(`Kalibriert: ${median.toFixed(0)} px/m ✓`);
}

async function startXRCalibration() {
  try {
    const session = await navigator.xr.requestSession('immersive-ar', {
      requiredFeatures: ['hit-test'],
    });

    STATE.xrSession = session;
    toast('AR-Session gestartet — scanne den Boden');

    // Simplified: after 3 seconds assume 1m = 100px at typical phone distance
    // In production: use hit-test to measure real-world distance
    setTimeout(async () => {
      // Dummy XR calibration fallback (real implementation needs WebXR hit-test loop)
      STATE.pixelsPerMeter = 120; // typical value — real XR would compute this
      STATE.calibrated     = true;
      await session.end();
      STATE.xrSession = null;
      closeCalModal();
      applyCalibrated();
      toast('AR-Kalibrierung abgeschlossen ✓');
    }, 3000);

  } catch(err) {
    toast('AR fehlgeschlagen: ' + err.message + ' — nutze Körpergröße');
    startBodyCalibration();
  }
}

function applyCalibrated() {
  const calStatus  = document.getElementById('cal-status');
  const calText    = document.getElementById('cal-status-text');
  calStatus.className = 'cal-status calibrated';
  calText.textContent = `Kalibriert ✓ — ${STATE.pixelsPerMeter?.toFixed(0)} px/m · ${STATE.userHeightCm}cm`;

  document.getElementById('btn-start').disabled = false;
  document.getElementById('btn-start').style.opacity = '1';
}


// ════════════════════════════════════════════════════════════════
// SECTION I — MEASUREMENT CONTROL
// ════════════════════════════════════════════════════════════════
function startMeasurement() {
  if (!STATE.calibrated) { toast('Bitte zuerst kalibrieren!'); return; }
  if (STATE.measuring)   return;

  // Countdown first
  const overlay = document.getElementById('countdown-overlay');
  const countNum = document.getElementById('count-num');
  overlay.style.display = 'flex';

  let count = CFG.COUNTDOWN_SEC;
  countNum.textContent = count;
  countNum.style.animation = 'none';
  void countNum.offsetWidth; // reflow
  countNum.style.animation = 'countPulse 0.9s ease-out';

  const interval = setInterval(() => {
    count--;
    if (count <= 0) {
      clearInterval(interval);
      countNum.textContent = 'GO!';
      countNum.style.color = 'var(--c-lime)';
      countNum.style.textShadow = '0 0 60px rgba(200,255,0,0.8)';
      countNum.style.animation = 'none';
      void countNum.offsetWidth;
      countNum.style.animation = 'countPulse 0.4s ease-out';
      setTimeout(() => {
        overlay.style.display = 'none';
        countNum.style.color = 'var(--c-cyan)';
        countNum.style.textShadow = '0 0 60px rgba(0,245,255,0.8)';
        beginMeasurement();
      }, 700);
    } else {
      countNum.textContent = count;
      countNum.style.animation = 'none';
      void countNum.offsetWidth;
      countNum.style.animation = 'countPulse 0.9s ease-out';
    }
  }, 900);
}

function beginMeasurement() {
  STATE.measuring      = true;
  STATE.measureStart   = performance.now();
  STATE.frameCount     = 0;
  STATE.confidenceSum  = 0;
  STATE.topSpeed       = 0;
  STATE.speedHistory   = [];
  STATE.speedBuffer    = [];
  STATE.lastHipX       = null;
  STATE.lastFrameTime  = null;
  STATE.currentSpeed   = 0;

  setStatus('measuring', 'Messung läuft');
  document.getElementById('btn-start').style.display = 'none';
  document.getElementById('btn-stop').style.display  = 'flex';
  document.getElementById('speed-hud').classList.add('visible');

  toast('⚡ Sprint-Messung gestartet!');
}

function stopMeasurement() {
  if (!STATE.measuring) return;
  STATE.measuring = false;

  setStatus('active', 'Messung beendet');
  document.getElementById('btn-stop').style.display  = 'none';
  document.getElementById('btn-start').style.display = 'flex';
  document.getElementById('speed-hud').classList.remove('visible');

  showResult();
}

function resetAll() {
  STATE.measuring     = false;
  STATE.topSpeed      = 0;
  STATE.currentSpeed  = 0;
  STATE.speedHistory  = [];
  STATE.speedBuffer   = [];
  STATE.lastHipX      = null;
  STATE.frameCount    = 0;

  document.getElementById('btn-stop').style.display  = 'none';
  document.getElementById('btn-start').style.display = 'flex';
  document.getElementById('speed-hud').classList.remove('visible');
  document.getElementById('live-speed').textContent  = '0.0';
  document.getElementById('m-topspeed').textContent  = '—';
  document.getElementById('m-pace').textContent      = '—';
  document.getElementById('wave-peak-label').textContent = 'Peak: —';
  setStatus('active', 'Bereit');
  drawWaveform();
