}


// ════════════════════════════════════════════════════════════════
// SECTION J — RESULT CARD & SHARING
// ════════════════════════════════════════════════════════════════
function showResult() {
  if (STATE.topSpeed < 0.5) {
    toast('Keine Messung — zu wenig Bewegung erkannt');
    return;
  }

  const speed    = STATE.topSpeed;
  const pace     = calculatePace(speed);
  const comp     = getComparison(speed);
  const avgSpeed = STATE.speedHistory.length
    ? (STATE.speedHistory.reduce((a,b) => a+b, 0) / STATE.speedHistory.length).toFixed(1)
    : '—';
  const avgConf  = STATE.frameCount
    ? ((STATE.confidenceSum / STATE.frameCount) * 100).toFixed(0) + '%'
    : '—';

  // Update card
  const now = new Date();
  document.getElementById('card-time').textContent  =
    now.toLocaleTimeString('de-DE', { hour:'2-digit', minute:'2-digit' });
  document.getElementById('card-speed').textContent = speed.toFixed(1);
  document.getElementById('card-pace').textContent  = pace;
  document.getElementById('card-icon').textContent  = comp.icon;
  document.getElementById('card-level').textContent = comp.level;
  document.getElementById('card-name').textContent  = comp.name;
  document.getElementById('stat-avg').textContent   = avgSpeed;
  document.getElementById('stat-frames').textContent = STATE.frameCount;
  document.getElementById('stat-conf').textContent  = avgConf;

  // Pace bar
  setTimeout(() => {
    document.getElementById('pace-bar').style.width = pace + '%';
  }, 400);

  // Apply comparison color
  document.getElementById('card-comparison').style.borderColor =
    comp.color + '44';
  document.getElementById('card-comparison').style.background =
    comp.color + '10';
  document.getElementById('card-name').style.color = comp.color;

  // Store for sharing
  STATE.lastResult = { speed, pace, comp, avgSpeed, avgConf, frames: STATE.frameCount };

  // Show overlay
  document.getElementById('result-overlay').classList.add('open');
}

function closeResult() {
  document.getElementById('result-overlay').classList.remove('open');
  // Reset pace bar for next time
  setTimeout(() => {
    document.getElementById('pace-bar').style.width = '0%';
  }, 300);
}

async function shareResult() {
  if (!STATE.lastResult) return;
  const { speed, pace, comp } = STATE.lastResult;
  const text = `🚀 Mein Sprint-Ergebnis mit SprintTrack Pro!\n\n⚡ Top-Geschwindigkeit: ${speed.toFixed(1)} km/h\n🎮 EA FC Pace: ${pace}/99\n${comp.icon} Level: ${comp.name}\n\n#SprintTrack #Football #Speed`;

  try {
    if (navigator.share) {
      await navigator.share({ title: 'SprintTrack Pro', text });
    } else {
      await navigator.clipboard.writeText(text);
      toast('Ergebnis in Zwischenablage kopiert!');
    }
  } catch(err) {
    try {
      await navigator.clipboard.writeText(text);
      toast('Ergebnis kopiert!');
    } catch {
      toast('Teilen nicht möglich');
    }
  }
}


// ════════════════════════════════════════════════════════════════
// SECTION K — SKELETON DRAWING (Canvas)
// ════════════════════════════════════════════════════════════════
function drawSkeleton(ctx, pose, canvas) {
  const kps     = pose.keypoints;
  const scaleX  = canvas.width  / (document.getElementById('video').videoWidth  || canvas.width);
  const scaleY  = canvas.height / (document.getElementById('video').videoHeight || canvas.height);

  // Draw connections
  ctx.lineWidth   = 2.5;
  ctx.lineCap     = 'round';
  ctx.shadowBlur  = 12;
  ctx.shadowColor = 'rgba(0,245,255,0.6)';
  ctx.strokeStyle = 'rgba(0,245,255,0.7)';

  SKELETON_PAIRS.forEach(([i, j]) => {
    const a = kps[i]; const b = kps[j];
    if (!a || !b) return;
    if ((a.score ?? 0) < CFG.CONF_THRESHOLD) return;
    if ((b.score ?? 0) < CFG.CONF_THRESHOLD) return;

    ctx.beginPath();
    ctx.moveTo(a.x * scaleX, a.y * scaleY);
    ctx.lineTo(b.x * scaleX, b.y * scaleY);
    ctx.stroke();
  });

  // Draw keypoints
  kps.forEach((kp, i) => {
    if (!kp || (kp.score ?? 0) < CFG.CONF_THRESHOLD) return;

    const x = kp.x * scaleX;
    const y = kp.y * scaleY;
    const isHip = (i === 11 || i === 12);

    ctx.shadowBlur  = isHip ? 20 : 10;
    ctx.shadowColor = isHip ? 'rgba(200,255,0,0.9)' : 'rgba(0,245,255,0.8)';
    ctx.fillStyle   = isHip ? 'var(--c-lime)'        : 'var(--c-cyan)';

    ctx.beginPath();
    ctx.arc(x, y, isHip ? 7 : 4, 0, Math.PI * 2);
    ctx.fill();

    // Hip label
    if (isHip) {
      ctx.shadowBlur = 0;
      ctx.fillStyle  = '#fff';
      ctx.font       = 'bold 9px system-ui';
      ctx.textAlign  = 'center';
      ctx.fillText(i === 11 ? 'L' : 'R', x, y - 10);
    }
  });

  ctx.shadowBlur = 0;
}


// ════════════════════════════════════════════════════════════════
// SECTION L — WAVEFORM DISPLAY
// ════════════════════════════════════════════════════════════════
function drawWaveform() {
  const canvas = document.getElementById('wave-canvas');
  const ctx    = canvas.getContext('2d');
  const W      = canvas.offsetWidth;
  const H      = canvas.offsetHeight;

  canvas.width  = W;
  canvas.height = H;

  // Background
  ctx.fillStyle = 'transparent';
  ctx.clearRect(0, 0, W, H);

  const data = STATE.speedHistory;
  if (data.length < 2) {
    // Draw flat baseline
    ctx.beginPath();
    ctx.strokeStyle = 'rgba(0,245,255,0.15)';
    ctx.lineWidth   = 1.5;
    ctx.setLineDash([4, 4]);
    ctx.moveTo(0, H * 0.7);
    ctx.lineTo(W, H * 0.7);
    ctx.stroke();
    ctx.setLineDash([]);
    return;
  }

  const maxSpeed = Math.max(...data, 10);
  const pad      = 10;

  // Gradient fill
  const grad = ctx.createLinearGradient(0, pad, 0, H);
  grad.addColorStop(0, 'rgba(0,245,255,0.4)');
  grad.addColorStop(1, 'rgba(0,245,255,0)');

  ctx.beginPath();
  ctx.moveTo(0, H);

  data.forEach((v, i) => {
    const x = (i / (data.length - 1)) * W;
    const y = H - pad - ((v / maxSpeed) * (H - pad * 2));
    if (i === 0) ctx.lineTo(x, y);
    else {
      const prevX = ((i-1) / (data.length - 1)) * W;
      const prevY = H - pad - ((data[i-1] / maxSpeed) * (H - pad * 2));
      const cpX   = (prevX + x) / 2;
      ctx.bezierCurveTo(cpX, prevY, cpX, y, x, y);
    }
  });

  ctx.lineTo(W, H);
  ctx.closePath();
  ctx.fillStyle = grad;
  ctx.fill();

  // Line
  ctx.beginPath();
  data.forEach((v, i) => {
    const x = (i / (data.length - 1)) * W;
    const y = H - pad - ((v / maxSpeed) * (H - pad * 2));
    if (i === 0) ctx.moveTo(x, y);
    else {
      const prevX = ((i-1) / (data.length - 1)) * W;
      const prevY = H - pad - ((data[i-1] / maxSpeed) * (H - pad * 2));
      const cpX   = (prevX + x) / 2;
      ctx.bezierCurveTo(cpX, prevY, cpX, y, x, y);
    }
  });

  ctx.strokeStyle = 'rgba(0,245,255,0.9)';
  ctx.lineWidth   = 2;
  ctx.shadowBlur  = 8;
  ctx.shadowColor = 'rgba(0,245,255,0.5)';
  ctx.stroke();
  ctx.shadowBlur  = 0;
}


// ════════════════════════════════════════════════════════════════
// SECTION M — UI UPDATE FUNCTIONS
// ════════════════════════════════════════════════════════════════
function updateSpeedUI(speed) {
  // Live speed display
  const liveEl   = document.getElementById('live-speed');
  const displaySpeed = speed < CFG.MIN_SPEED_KMH ? 0 : speed;
  liveEl.textContent = displaySpeed.toFixed(1);
  liveEl.className   = 'speed-value' + (speed > 30 ? ' fast' : '');

  // Top speed
  document.getElementById('m-topspeed').textContent =
    STATE.topSpeed.toFixed(1);

  // EA FC Pace
  const pace = calculatePace(STATE.topSpeed);
  document.getElementById('m-pace').textContent = pace;

  // Wave peak
  document.getElementById('wave-peak-label').textContent =
    'Peak: ' + STATE.topSpeed.toFixed(1);

  // Draw waveform every 3 frames (performance)
  if (STATE.frameCount % 3 === 0) drawWaveform();
}

function updateHeightDisplay(val) {
  document.getElementById('height-val').textContent = val;
}

function setStatus(type, text) {
  const pill = document.getElementById('status-pill');
  const span = document.getElementById('status-text');
  pill.className = 'status-pill ' + type;
  span.textContent = text;
}

// ── TOAST NOTIFICATION ─────────────────────────────────────────
let toastTimer = null;
function toast(msg) {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove('show'), 3000);
}

// ── MODAL CONTROL ──────────────────────────────────────────────
function openCalModal() {
  document.getElementById('cal-modal').classList.add('open');
  document.getElementById('cal-progress').style.display = 'none';
}

function closeCalModal() {
  STATE.calInProgress = false;
  document.getElementById('cal-modal').classList.remove('open');
}

// ── SCAN (WebXR) ───────────────────────────────────────────────
async function doScan() {
  if (STATE.xrSupported) {
    toast('AR-Scan wird gestartet...');
    openCalModal();
    selectCalMethod('xr');
  } else {
    toast('WebXR nicht verfügbar — nutze Körpergröße');
    openCalModal();
    selectCalMethod('body');
  }
}


// ════════════════════════════════════════════════════════════════
// SECTION N — INITIALIZATION
// ════════════════════════════════════════════════════════════════
(async function init() {
  // Start waveform baseline
  drawWaveform();
  window.addEventListener('resize', drawWaveform);

  // Prevent zoom on double tap
  document.addEventListener('dblclick', e => e.preventDefault(), { passive: false });

  // Auto-init camera if permission already granted
  if (navigator.permissions) {
    try {
      const result = await navigator.permissions.query({ name: 'camera' });
      if (result.state === 'granted') {
        initCamera();
      }
    } catch {
      // permissions API not supported — wait for user click
    }
  }
})();
</script>

