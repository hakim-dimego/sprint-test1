<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>SprintTrack Pro — Football Speed Analyzer</title>

<!-- ═══════════════════════════════════════════════════════════
     DESIGN SYSTEM: Sports Tech / HUD Sci-Fi FUI
     Style: Dark Mode OLED + Cyberpunk UI + Real-Time Monitoring
     Colors: #00F5FF (Cyan Electric), #FF3B30 (Signal Red),
             #C8FF00 (Acid Lime), #0A0A0F (Deep Black)
     Typography: system-ui stack, monospace for data
     Pattern: Real-Time Monitoring Dashboard
     ═══════════════════════════════════════════════════════════ -->

<script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.15.0/dist/tf.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/pose-detection@2.1.3/dist/pose-detection.min.js"></script>

<style>
  /* ── DESIGN TOKENS ─────────────────────────────────────────── */
  :root {
    --c-bg:        #05050A;
    --c-surface:   #0D0D1A;
    --c-surface2:  #12121F;
    --c-border:    rgba(0,245,255,0.12);
    --c-border-hi: rgba(0,245,255,0.4);
    --c-cyan:      #00F5FF;
    --c-cyan-dim:  rgba(0,245,255,0.15);
    --c-lime:      #C8FF00;
    --c-lime-dim:  rgba(200,255,0,0.12);
    --c-red:       #FF3B30;
    --c-red-dim:   rgba(255,59,48,0.15);
    --c-gold:      #FFD700;
    --c-text:      #E8EAF0;
    --c-muted:     rgba(232,234,240,0.45);
    --c-dim:       rgba(232,234,240,0.2);
    --r-sm:        8px;
    --r-md:        14px;
    --r-lg:        20px;
    --r-xl:        28px;
    --shadow-cyan: 0 0 20px rgba(0,245,255,0.25), 0 0 60px rgba(0,245,255,0.08);
    --shadow-lime: 0 0 20px rgba(200,255,0,0.25), 0 0 60px rgba(200,255,0,0.08);
    --shadow-red:  0 0 20px rgba(255,59,48,0.3),  0 0 60px rgba(255,59,48,0.1);
    --trans:       all 0.2s cubic-bezier(0.4,0,0.2,1);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

  html, body {
    height: 100%;
    background: var(--c-bg);
    color: var(--c-text);
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', system-ui, sans-serif;
    overflow: hidden;
    overscroll-behavior: none;
  }

  /* ── SCANLINE OVERLAY (HUD aesthetic) ──────────────────────── */
  body::before {
    content: '';
    position: fixed; inset: 0; z-index: 9999;
    background: repeating-linear-gradient(
      0deg, transparent, transparent 2px,
      rgba(0,0,0,0.03) 2px, rgba(0,0,0,0.03) 4px
    );
    pointer-events: none;
  }

  /* ── LAYOUT ────────────────────────────────────────────────── */
  #app {
    display: flex;
    flex-direction: column;
    height: 100dvh;
    max-width: 480px;
    margin: 0 auto;
    position: relative;
  }

  /* ── HEADER / HUD BAR ──────────────────────────────────────── */
  #header {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px 10px;
    background: linear-gradient(180deg, rgba(5,5,10,0.98) 0%, rgba(5,5,10,0.85) 100%);
    border-bottom: 1px solid var(--c-border);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    position: relative;
    z-index: 100;
  }

  .logo-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .logo-icon {
    width: 34px; height: 34px;
    background: linear-gradient(135deg, var(--c-cyan), var(--c-lime));
    border-radius: 9px;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px;
    box-shadow: var(--shadow-cyan);
    flex-shrink: 0;
  }

  .logo-text {
    display: flex; flex-direction: column;
    line-height: 1.1;
  }

  .logo-title {
    font-size: 15px; font-weight: 700;
    letter-spacing: -0.3px;
    background: linear-gradient(90deg, var(--c-cyan), var(--c-lime));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .logo-sub {
    font-size: 9px; font-weight: 500;
    color: var(--c-muted);
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  /* Status pill */
  .status-pill {
    display: flex; align-items: center; gap: 6px;
    padding: 5px 10px;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 20px;
    font-size: 10px; font-weight: 600;
    color: var(--c-muted);
    letter-spacing: 0.8px;
    text-transform: uppercase;
    transition: var(--trans);
  }

  .status-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--c-muted);
    transition: var(--trans);
  }

  .status-pill.active .status-dot { background: var(--c-lime); box-shadow: 0 0 8px var(--c-lime); }
  .status-pill.active { color: var(--c-lime); border-color: rgba(200,255,0,0.3); }
  .status-pill.measuring .status-dot {
    background: var(--c-red);
    box-shadow: 0 0 8px var(--c-red);
    animation: blink 0.8s ease-in-out infinite;
  }
  .status-pill.measuring { color: var(--c-red); border-color: rgba(255,59,48,0.3); }

  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.4} }

  /* ── VIDEO / CANVAS AREA ────────────────────────────────────── */
  #camera-zone {
    flex: 1;
    position: relative;
    overflow: hidden;
    background: #000;
    min-height: 0;
  }

  #video {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transform: scaleX(-1);
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  #video.ready { opacity: 1; }

  #canvas {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    transform: scaleX(-1);
  }

  /* ── HUD CORNERS ────────────────────────────────────────────── */
  .hud-corner {
    position: absolute;
    width: 24px; height: 24px;
    pointer-events: none;
    z-index: 10;
  }
  .hud-corner::before, .hud-corner::after {
    content: '';
    position: absolute;
    background: var(--c-cyan);
    box-shadow: 0 0 8px var(--c-cyan);
  }
  .hud-corner::before { width: 2px; height: 100%; }
  .hud-corner::after  { width: 100%; height: 2px; }

  .hud-tl { top: 12px; left: 12px; }
  .hud-tr { top: 12px; right: 12px; transform: scaleX(-1); }
  .hud-bl { bottom: 12px; left: 12px; transform: scaleY(-1); }
  .hud-br { bottom: 12px; right: 12px; transform: scale(-1); }

  /* ── LIVE SPEED DISPLAY (HUD overlay) ──────────────────────── */
  #speed-hud {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    pointer-events: none;
    z-index: 20;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  #speed-hud.visible { opacity: 1; }

  .speed-value {
    font-size: clamp(52px, 14vw, 76px);
    font-weight: 800;
    letter-spacing: -3px;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: #fff;
    text-shadow: 0 0 30px rgba(0,245,255,0.8), 0 0 60px rgba(0,245,255,0.4);
    transition: color 0.2s ease;
  }

  .speed-value.fast {
    color: var(--c-lime);
    text-shadow: 0 0 30px rgba(200,255,0,0.8), 0 0 60px rgba(200,255,0,0.4);
  }

  .speed-unit {
    font-size: 13px; font-weight: 600;
    color: var(--c-cyan);
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-top: 2px;
  }

  /* ── MINI METRICS ROW (overlay) ────────────────────────────── */
  #mini-metrics {
    position: absolute;
    bottom: 14px; left: 0; right: 0;
    display: flex;
    justify-content: space-around;
    padding: 0 12px;
    pointer-events: none;
    z-index: 20;
  }

  .mini-metric {
    background: rgba(5,5,10,0.75);
    border: 1px solid var(--c-border);
    border-radius: var(--r-sm);
    padding: 6px 10px;
    text-align: center;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    min-width: 64px;
  }

  .mini-metric-val {
    font-size: 16px; font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--c-cyan);
    line-height: 1;
  }

  .mini-metric-lbl {
    font-size: 8px; font-weight: 600;
    color: var(--c-muted);
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-top: 2px;
  }

  /* ── COUNTDOWN OVERLAY ──────────────────────────────────────── */
  #countdown-overlay {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    flex-direction: column;
    gap: 12px;
    background: rgba(5,5,10,0.6);
    backdrop-filter: blur(4px);
    z-index: 30;
    display: none;
  }

  .countdown-num {
    font-size: 120px; font-weight: 900;
    color: var(--c-cyan);
    text-shadow: 0 0 60px rgba(0,245,255,0.8);
    line-height: 1;
    animation: countPulse 0.9s ease-out;
  }

  .countdown-label {
    font-size: 14px; font-weight: 600;
    color: var(--c-muted);
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  @keyframes countPulse {
    0%   { transform: scale(1.6); opacity: 0; }
    40%  { transform: scale(0.95); opacity: 1; }
    100% { transform: scale(1); opacity: 1; }
  }

  /* ── BOTTOM PANEL ───────────────────────────────────────────── */
  #bottom-panel {
    flex-shrink: 0;
    background: var(--c-surface);
    border-top: 1px solid var(--c-border);
    padding: 14px 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
    z-index: 100;
  }

  /* ── WAVEFORM GRAPH ─────────────────────────────────────────── */
  #wave-container {
    background: var(--c-surface2);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    overflow: hidden;
    height: 52px;
    position: relative;
  }

  #wave-canvas {
    width: 100%; height: 100%;
    display: block;
  }

  .wave-label {
    position: absolute;
    top: 6px; left: 10px;
    font-size: 8px; font-weight: 700;
    color: var(--c-muted);
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .wave-peak {
    position: absolute;
    top: 6px; right: 10px;
    font-size: 10px; font-weight: 700;
    color: var(--c-lime);
    font-variant-numeric: tabular-nums;
  }

  /* ── BUTTON GRID ────────────────────────────────────────────── */
  #btn-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  /* ── BUTTONS ────────────────────────────────────────────────── */
  .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px 16px;
    border-radius: var(--r-md);
    border: 1px solid var(--c-border);
    background: var(--c-surface2);
    color: var(--c-text);
    font-size: 13px; font-weight: 600;
    cursor: pointer;
    transition: var(--trans);
    letter-spacing: 0.2px;
    position: relative;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
  }

  .btn::before {
    content: '';
    position: absolute; inset: 0;
    background: currentColor;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .btn:active::before { opacity: 0.08; }
  .btn:hover { transform: translateY(-1px); }
  .btn:active { transform: translateY(0); }

  .btn svg { flex-shrink: 0; }

  /* Scan */
  .btn-scan {
    border-color: rgba(0,245,255,0.3);
    background: var(--c-cyan-dim);
    color: var(--c-cyan);
  }
  .btn-scan:hover { box-shadow: var(--shadow-cyan); border-color: var(--c-cyan); }

  /* Calibrate */
  .btn-cal {
    border-color: rgba(200,255,0,0.25);
    background: var(--c-lime-dim);
    color: var(--c-lime);
  }
  .btn-cal:hover { box-shadow: var(--shadow-lime); border-color: var(--c-lime); }

  /* Start — full width, accent */
  .btn-start {
    grid-column: 1 / -1;
    background: linear-gradient(135deg, var(--c-cyan) 0%, #0096FF 100%);
    border-color: var(--c-cyan);
    color: #000;
    font-size: 15px; font-weight: 800;
    letter-spacing: 0.5px;
    padding: 15px;
    box-shadow: var(--shadow-cyan);
  }
  .btn-start:hover { filter: brightness(1.1); box-shadow: 0 0 30px rgba(0,245,255,0.5); }
  .btn-start:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
    filter: none;
  }

  /* Stop */
  .btn-stop {
    grid-column: 1 / -1;
    background: linear-gradient(135deg, var(--c-red), #FF6B6B);
    border-color: var(--c-red);
    color: #fff;
    font-size: 15px; font-weight: 800;
    letter-spacing: 0.5px;
    padding: 15px;
    box-shadow: var(--shadow-red);
    display: none;
  }

  /* Reset */
  .btn-reset {
    border-color: rgba(232,234,240,0.12);
  }
  .btn-reset:hover { border-color: rgba(232,234,240,0.25); }

  /* ── TOAST ──────────────────────────────────────────────────── */
  #toast {
    position: fixed;
    top: 70px; left: 50%; transform: translateX(-50%) translateY(-8px);
    background: var(--c-surface);
    border: 1px solid var(--c-border-hi);
    border-radius: 30px;
    padding: 10px 20px;
    font-size: 12px; font-weight: 600;
    color: var(--c-cyan);
    z-index: 9000;
    opacity: 0;
    pointer-events: none;
    transition: all 0.25s ease;
    white-space: nowrap;
    box-shadow: var(--shadow-cyan);
    max-width: 90vw;
    text-align: center;
    letter-spacing: 0.3px;
  }

  #toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* ── CALIBRATION MODAL ──────────────────────────────────────── */
  #cal-modal {
    position: fixed; inset: 0;
    background: rgba(5,5,10,0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    z-index: 500;
    display: none;
    align-items: flex-end;
    justify-content: center;
    padding: 0 0 0 0;
  }

  #cal-modal.open {
    display: flex;
    animation: slideUp 0.3s cubic-bezier(0.4,0,0.2,1);
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(40px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .modal-sheet {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-bottom: none;
    border-radius: var(--r-xl) var(--r-xl) 0 0;
    padding: 28px 24px 40px;
    width: 100%;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .sheet-handle {
    width: 40px; height: 4px;
    background: rgba(232,234,240,0.2);
    border-radius: 2px;
    margin: 0 auto -8px;
  }

  .modal-title {
    font-size: 20px; font-weight: 800;
    letter-spacing: -0.5px;
    color: var(--c-text);
  }

  .modal-sub {
    font-size: 13px;
    color: var(--c-muted);
    margin-top: 4px;
    line-height: 1.5;
  }

  /* Height slider */
  .slider-group { display: flex; flex-direction: column; gap: 10px; }

  .slider-row {
    display: flex; align-items: center; gap: 14px;
  }

  .slider-val {
    font-size: 28px; font-weight: 800;
    color: var(--c-cyan);
    font-variant-numeric: tabular-nums;
    min-width: 80px;
    text-align: right;
  }

  input[type="range"] {
    flex: 1;
    -webkit-appearance: none;
    appearance: none;
    height: 4px;
    background: var(--c-border);
    border-radius: 2px;
    outline: none;
  }

  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 22px; height: 22px;
    border-radius: 50%;
    background: var(--c-cyan);
    box-shadow: 0 0 12px rgba(0,245,255,0.5);
    cursor: pointer;
    border: 2px solid #fff;
  }

  .cal-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .cal-option {
    background: var(--c-surface2);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    padding: 14px;
    cursor: pointer;
    text-align: center;
    transition: var(--trans);
  }

  .cal-option:hover { border-color: var(--c-cyan); }

  .cal-option-icon { font-size: 22px; margin-bottom: 6px; }
  .cal-option-name { font-size: 12px; font-weight: 700; color: var(--c-text); }
  .cal-option-desc { font-size: 10px; color: var(--c-muted); margin-top: 2px; }

  .btn-confirm {
    width: 100%;
    padding: 15px;
    background: linear-gradient(135deg, var(--c-lime), #7FFF00);
    border: none;
    border-radius: var(--r-md);
    color: #000;
    font-size: 15px; font-weight: 800;
    cursor: pointer;
    transition: var(--trans);
    box-shadow: var(--shadow-lime);
  }

  .btn-confirm:hover { filter: brightness(1.1); transform: translateY(-1px); }
  .btn-confirm:active { transform: translateY(0); }

  /* ── PLAYER CARD (Result) ───────────────────────────────────── */
  #result-overlay {
    position: fixed; inset: 0;
    background: rgba(5,5,10,0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 800;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    overflow-y: auto;
  }

  #result-overlay.open {
    display: flex;
    animation: fadeIn 0.4s ease;
  }

  @keyframes fadeIn { from{opacity:0} to{opacity:1} }

  .player-card {
    width: 100%;
    max-width: 360px;
    background: linear-gradient(145deg, #0D1520 0%, #0A0F1A 50%, #050A12 100%);
    border: 1px solid rgba(0,245,255,0.25);
    border-radius: var(--r-xl);
    overflow: hidden;
    position: relative;
    box-shadow: 0 0 80px rgba(0,245,255,0.15), 0 40px 80px rgba(0,0,0,0.8);
    animation: cardSlideIn 0.5s cubic-bezier(0.34,1.56,0.64,1);
  }

  @keyframes cardSlideIn {
    from { transform: scale(0.8) translateY(40px); opacity: 0; }
    to   { transform: scale(1) translateY(0); opacity: 1; }
  }

  /* Card grid lines (EA FC aesthetic) */
  .card-grid {
    position: absolute; inset: 0; pointer-events: none; overflow: hidden;
  }

  .card-grid::before {
    content: '';
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, transparent 49.5%, rgba(0,245,255,0.04) 50%, transparent 50.5%),
      linear-gradient(0deg,  transparent 49.5%, rgba(0,245,255,0.04) 50%, transparent 50.5%);
    background-size: 40px 40px;
  }

  /* Glow orbs */
  .card-glow-1 {
    position: absolute; top: -60px; left: -60px;
    width: 200px; height: 200px;
    background: radial-gradient(circle, rgba(0,245,255,0.12) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .card-glow-2 {
    position: absolute; bottom: -40px; right: -40px;
    width: 160px; height: 160px;
    background: radial-gradient(circle, rgba(200,255,0,0.1) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  /* Card Header */
  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 22px 0;
    position: relative;
  }

  .card-badge {
    font-size: 9px; font-weight: 800;
    color: var(--c-cyan);
    letter-spacing: 2px;
    text-transform: uppercase;
    background: var(--c-cyan-dim);
    border: 1px solid rgba(0,245,255,0.3);
    border-radius: 4px;
    padding: 3px 8px;
  }

  .card-timestamp {
    font-size: 10px;
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
    font-family: 'SF Mono', 'Fira Code', monospace;
  }

  /* Big speed number */
  .card-speed-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 24px 22px 16px;
    position: relative;
  }

  .card-speed-label {
    font-size: 10px; font-weight: 700;
    color: var(--c-muted);
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .card-speed-num {
    font-size: 88px; font-weight: 900;
    letter-spacing: -6px;
    line-height: 1;
    background: linear-gradient(180deg, #fff 0%, rgba(0,245,255,0.8) 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
    font-variant-numeric: tabular-nums;
  }

  .card-speed-unit {
    font-size: 14px; font-weight: 600;
    color: var(--c-cyan);
    letter-spacing: 3px;
    margin-top: -4px;
  }

  /* Pace bar */
  .card-pace-section {
    margin: 0 22px 20px;
    background: rgba(0,0,0,0.3);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    padding: 14px 16px;
    position: relative;
  }

  .pace-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .pace-label {
    font-size: 10px; font-weight: 700;
    color: var(--c-muted);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .pace-value {
    font-size: 36px; font-weight: 900;
    color: var(--c-lime);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    text-shadow: 0 0 20px rgba(200,255,0,0.5);
  }

  .pace-bar-track {
    height: 8px;
    background: rgba(232,234,240,0.08);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
  }

  .pace-bar-fill {
    height: 100%;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--c-cyan), var(--c-lime));
    width: 0%;
    transition: width 1.2s cubic-bezier(0.4,0,0.2,1);
    box-shadow: 0 0 12px rgba(200,255,0,0.4);
    position: relative;
  }

  .pace-bar-fill::after {
    content: '';
    position: absolute;
    right: 0; top: 50%;
    transform: translateY(-50%);
    width: 10px; height: 10px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(255,255,255,0.8);
  }

  /* Comparison tag */
  .card-comparison {
    margin: 0 22px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(200,255,0,0.06);
    border: 1px solid rgba(200,255,0,0.2);
    border-radius: var(--r-md);
    padding: 12px 16px;
  }

  .comparison-icon { font-size: 24px; }

  .comparison-text { flex: 1; }

  .comparison-level {
    font-size: 11px; font-weight: 700;
    color: var(--c-muted);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 2px;
  }

  .comparison-name {
    font-size: 15px; font-weight: 800;
    color: var(--c-lime);
    letter-spacing: -0.3px;
  }

  /* Stats row */
  .card-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin: 0 22px 22px;
    background: var(--c-border);
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--c-border);
  }

  .card-stat {
    background: var(--c-surface2);
    padding: 12px 8px;
    text-align: center;
  }

  .stat-val {
    font-size: 18px; font-weight: 800;
    color: var(--c-text);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .stat-lbl {
    font-size: 9px; font-weight: 600;
    color: var(--c-muted);
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-top: 3px;
  }

  /* Card actions */
  .card-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding: 0 22px 24px;
  }

  .card-btn {
    padding: 12px;
    border-radius: var(--r-md);
    border: 1px solid var(--c-border);
    background: var(--c-surface2);
    color: var(--c-text);
    font-size: 12px; font-weight: 700;
    cursor: pointer;
    transition: var(--trans);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    letter-spacing: 0.3px;
  }

  .card-btn:hover { transform: translateY(-1px); border-color: var(--c-border-hi); }
  .card-btn:active { transform: translateY(0); }

  .card-btn.primary {
    background: var(--c-cyan-dim);
    border-color: rgba(0,245,255,0.35);
    color: var(--c-cyan);
  }

  /* ── NO CAMERA STATE ────────────────────────────────────────── */
  #no-camera {
    position: absolute; inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    background: var(--c-surface);
    z-index: 5;
    padding: 30px;
    text-align: center;
  }

  .nc-icon {
    width: 72px; height: 72px;
    background: var(--c-cyan-dim);
    border: 1px solid rgba(0,245,255,0.3);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
    margin-bottom: 4px;
  }

  .nc-title { font-size: 20px; font-weight: 800; }
  .nc-sub   { font-size: 13px; color: var(--c-muted); line-height: 1.5; }

  .btn-camera {
    padding: 14px 28px;
    background: linear-gradient(135deg, var(--c-cyan), #0096FF);
    border: none;
    border-radius: var(--r-md);
    color: #000;
    font-size: 14px; font-weight: 800;
    cursor: pointer;
    transition: var(--trans);
    margin-top: 8px;
    box-shadow: var(--shadow-cyan);
  }
  .btn-camera:hover { filter: brightness(1.1); transform: translateY(-1px); }

  /* ── LOADING STATE ──────────────────────────────────────────── */
  #loading-overlay {
    position: absolute; inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    background: rgba(5,5,10,0.85);
    backdrop-filter: blur(8px);
    z-index: 50;
    transition: opacity 0.5s ease;
  }

  #loading-overlay.hidden { opacity: 0; pointer-events: none; }

  .loader-ring {
    width: 56px; height: 56px;
    border: 3px solid var(--c-border);
    border-top-color: var(--c-cyan);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    box-shadow: 0 0 20px rgba(0,245,255,0.3);
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  .loader-text {
    font-size: 12px; font-weight: 600;
    color: var(--c-cyan);
    letter-spacing: 2px;
    text-transform: uppercase;
    text-align: center;
  }

  .loader-dots span {
    display: inline-block;
    animation: dotFade 1.2s ease-in-out infinite;
  }
  .loader-dots span:nth-child(2) { animation-delay: 0.2s; }
  .loader-dots span:nth-child(3) { animation-delay: 0.4s; }

  @keyframes dotFade { 0%,80%,100%{opacity:0.2} 40%{opacity:1} }

  /* ── FPS INDICATOR ──────────────────────────────────────────── */
  #fps-badge {
    position: absolute;
    top: 14px;
    right: 50%;
    transform: translateX(50%);
    background: rgba(5,5,10,0.75);
    border: 1px solid var(--c-border);
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 10px;
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
    font-family: 'SF Mono', monospace;
    z-index: 25;
    pointer-events: none;
    backdrop-filter: blur(8px);
  }

  /* ── CALIBRATION STATUS BAR ─────────────────────────────────── */
  #cal-status {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 600;
    color: var(--c-muted);
    padding: 6px 0 0;
  }

  #cal-status .cal-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--c-muted);
  }

  #cal-status.calibrated .cal-dot { background: var(--c-lime); box-shadow: 0 0 6px var(--c-lime); }
  #cal-status.calibrated { color: var(--c-lime); }

  /* ── WEBXR INDICATOR ────────────────────────────────────────── */
  #xr-badge {
    position: absolute;
    top: 14px; left: 14px;
    background: rgba(5,5,10,0.75);
    border: 1px solid var(--c-border);
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 9px; font-weight: 700;
    color: var(--c-muted);
    letter-spacing: 1px;
    text-transform: uppercase;
    z-index: 25;
    pointer-events: none;
    backdrop-filter: blur(8px);
  }

  /* ── REDUCED MOTION ─────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }

  /* ── LANDSCAPE COMPACT ──────────────────────────────────────── */
  @media (orientation: landscape) and (max-height: 500px) {
    #bottom-panel { padding: 8px 16px 10px; gap: 6px; }
    #wave-container { height: 36px; }
    .btn { padding: 9px 12px; font-size: 12px; }
    .btn-start, .btn-stop { padding: 10px; }
  }
</style>
</head>
